# PackSentry Environment Configuration Template (ADR-0013, ADR-0015)
# Copy to .env and fill in real values. Never commit .env to git.

# 1. Supabase Postgres Connection (Session mode pooler or direct connection)
# Example: postgresql://postgres.eputttzflupbxqvvssvz:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 2. Supabase Storage & API Gateway (Service Role Key stays server-side only)
SUPABASE_URL=https://eputttzflupbxqvvssvz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google Cloud Vision Credentials (ADC JSON Key Path)
# Instructions at .sensitive-docs/harness/GOOGLE_APPLICATION_CREDENTIALS.md
GOOGLE_APPLICATION_CREDENTIALS=

# 4. Ollama Host for local Qwen2.5-VL inference (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# 5. Google AI Studio Gemini API Key (for Gemini 2.5 Flash OCR adapter)
GEMINI_API_KEY=
