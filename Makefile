.PHONY: schema test test-backend test-frontend clean

PYTHON ?= python3
NPM ?= npm
FLUTTER ?= flutter

schema:
	@echo "==> Exporting JSON Schemas from lmpc_schema..."
	@PYTHONPATH=. $(PYTHON) -m lmpc_schema.export
	@echo "==> Generating Dart models into Frontend/app/lib/models/generated/..."
	@mkdir -p Frontend/app/lib/models/generated
	@npx --yes quicktype \
		--src lmpc_schema/dist/lmpc_schema.json \
		--src-lang schema \
		--lang dart \
		-o Frontend/app/lib/models/generated/lmpc_models.dart \
		--coders-in-class
	@echo "==> Prepending generated warning header..."
	@sed -i '1s/^/\/\/ GENERATED CODE - DO NOT MODIFY BY HAND\n\/\/ Generated by `make schema` using quicktype from lmpc_schema\n\/\/ ignore_for_file: type=lint, unused_import, duplicate_ignore\n\n/' Frontend/app/lib/models/generated/lmpc_models.dart
	@echo "==> Schema generation complete."

test-backend:
	@echo "==> Running backend and schema tests..."
	@PYTHONPATH=. pytest Backend/tests/

test-frontend:
	@echo "==> Running Flutter analyzer and tests..."
	@cd Frontend/app && $(FLUTTER) analyze
	@cd Frontend/app && $(FLUTTER) test test/models/

test: test-backend test-frontend

clean:
	@rm -rf lmpc_schema/dist/
