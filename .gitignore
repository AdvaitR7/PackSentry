node_modules/
dist/
build/
.next/
.nuxt/
.output/
.cache/
*.tsbuildinfo

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ─── Runtime Output ───────────────────────────────────────────────────────────
Backend/app/received_scans/
Backend/scratch/

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.json

# Service-account / credential files
*-key.json
*credentials*.json
serviceAccount*.json
*.p12

# Android / Flutter signing material
key.properties
*.jks
*.keystore

# ─── Local-Only Docs & AI Harness ─────────────────────────────────────────────
