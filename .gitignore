# entries are what protect these paths on any other checkout.
.sensitive-docs/
code-agent/
.claude/

# ─── OS Artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
scratch/
**/scratch/

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
